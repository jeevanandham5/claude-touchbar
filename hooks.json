      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/ClaudeTouchBar.app/Contents/MacOS/claude-touchbar-hook\" SessionStart 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
